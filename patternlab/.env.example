DEPLOYMENT_ENV=dev                # dev -> groq, prod -> ollama (override with LLM_PROVIDER)
LLM_PROVIDER=                     # anthropic | groq | ollama | openai (empty = derived from DEPLOYMENT_ENV)
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:14b
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_MODEL=claude-sonnet-4-6

# Phase 2
OANDA_API_TOKEN=                  # TODO: practice account token
OANDA_ACCOUNT_ID=
DATABASE_URL=postgresql+asyncpg://patternlab:patternlab@db:5432/patternlab
