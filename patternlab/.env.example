# dev -> groq, prod -> ollama (override with LLM_PROVIDER)
DEPLOYMENT_ENV=dev
# anthropic | groq | ollama | openai (empty = derived from DEPLOYMENT_ENV)
LLM_PROVIDER=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:14b
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_MODEL=claude-sonnet-4-6

# TradingView (tvDatafeed) — optional login; anonymous works for most symbols
TV_USERNAME=
TV_PASSWORD=

# Phase 2 — OANDA practice account (official data fallback)
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
DATABASE_URL=postgresql+asyncpg://patternlab:patternlab@db:5432/patternlab
